# ========================================================
# Codeforces Configuration
# ========================================================
# Your Codeforces username/handle (used to filter out problems you already solved)
CF_HANDLE=tourist

# Target rating range (e.g. MIN_RATING=1200 and MAX_RATING=1600)
# Leave empty or set to 0 for automatic detection based on your current rating (+100 to +300)
MIN_RATING=1000
MAX_RATING=1500

# Optional: Specific tags separated by comma (e.g., dp,graphs,math,greedy,binary search,data structures)
# Leave empty to select across all problem types
PREFERRED_TAGS=

# ========================================================
# WhatsApp Notification Gateway (CallMeBot - Recommended)
# ========================================================
# 1. Add phone number +34 644 44 20 86 (or current CallMeBot bot number) to your WhatsApp contacts
# 2. Send the message: "I allow callmebot to send me messages" via WhatsApp
# 3. You will instantly receive your apikey in reply!
#
# Phone number format with country code, NO plus sign, NO spaces (e.g. 919876543210 for India, 14155552671 for US)
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=

# ========================================================
# Alternative Gateway: Twilio WhatsApp (Optional)
# ========================================================
USE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=whatsapp:+14155238886
TWILIO_TO_NUMBER=
